# === VIBESHOP ENVIRONMENT CONFIGURATION ===
# 
# LOCAL DEVELOPMENT: Copy to .env and fill in local values
# RENDER DEPLOYMENT: Set these in Render dashboard → Environment Variables
#

# === Application Settings ===
APP_ENV=production
APP_DEBUG=false

# === PostgreSQL Database (REQUIRED) ===
# Use DATABASE_URL for Render (recommended):
DATABASE_URL=postgresql://username:password@hostname/database

# === Google Cloud / Vertex AI (Optional - for AI embeddings) ===
GOOGLE_PROJECT_ID=
GOOGLE_REGION=us-central1

# === Twilio WhatsApp (Optional - for WhatsApp integration) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# === USSD Payment Gateway (Optional - for mobile payments) ===
USSD_PROVIDER_URL=
USSD_API_KEY=

# === Feature Flags (Optional) ===
ENABLE_USSD_PAYMENT=false
ENABLE_SELLER_NOTIFICATIONS=true
